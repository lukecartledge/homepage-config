# Homepage environment variables
# Copy to .env and fill in real values
# Docs: https://gethomepage.dev/installation/docker/#using-environment-secrets

HOMEPAGE_VAR_PAPERLESS_KEY=your-paperless-ngx-api-key
HOMEPAGE_VAR_JELLYFIN_KEY=your-jellyfin-api-key
HOMEPAGE_VAR_HASS_TOKEN=your-home-assistant-long-lived-token
HOMEPAGE_VAR_QBT_USER=your-qbittorrent-username
HOMEPAGE_VAR_QBT_PASS=your-qbittorrent-password
# HOMEPAGE_VAR_PIHOLE_KEY — not required: Pi-hole has no API password set and
# the widget runs unauthenticated. Add back only if you set one.
HOMEPAGE_VAR_TRUENAS_KEY=your-truenas-api-key
HOMEPAGE_VAR_MEALIE_KEY=your-mealie-api-token
